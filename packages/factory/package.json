{
  "name": "factory",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/web-fetch.js"
    ]
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./config-reloader": {
      "types": "./dist/src/config-reloader.d.ts",
      "default": "./dist/src/config-reloader.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./web": {
      "types": "./dist/src/web-config.d.ts",
      "default": "./dist/src/web-config.js"
    }
  },
  "files": [
    "dist",
    "bin/factory.js",
    "bin/workflow-loader.js"
  ],
  "bin": {
    "factory": "./bin/factory.js"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"for (const file of ['dist/src/index.js', 'dist/src/index.d.ts', 'dist/web/handler.js']) { if (!require('node:fs').existsSync(file)) throw new Error('Run pnpm build from the repository root before packing Factory'); }\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "color-name": "^2.0.0",
    "execa": "^10.0.1",
    "human-id": "4.2.1",
    "jiti": "^2.7.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/color-name": "^2.0.0",
    "@types/node": "^22",
    "typescript": "~5.9.3"
  }
}
