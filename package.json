{
  "name": "factory-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "factory": "node packages/factory/bin/factory.js",
    "dev:web": "node --import tsx apps/web/src/bin/factory-web.ts",
    "build": "pnpm --filter factory build && pnpm --filter @factory/web build && node scripts/bundle-web.mjs",
    "test": "vitest run",
    "check": "pnpm run check:root && pnpm -r check",
    "check:root": "tsc --noEmit",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "factory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0",
    "typescript": "~5.9.3"
  }
}
