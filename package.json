{
  "name": "factory-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "factory-web",
    "link": "bun link --cwd packages/factory && bun link --cwd apps/web",
    "test": "bun test",
    "check": "bun run check:root && bun run --filter '*' check",
    "check:root": "tsc --noEmit"
  },
  "dependencies": {
    "factory": "workspace:*",
    "factory-web": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^7"
  }
}
